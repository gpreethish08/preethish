# ==============================================================================
# 🛡️ VAULT DISTRIBUTED OBJECT STORAGE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network & Environment
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://gpreethish08.github.io

# Persistence & Storage
DB_PATH=./vault.db
CHUNK_SIZE=2097152
DEFAULT_REPLICATION=3
MAX_UPLOAD_SIZE=10737418240

# Cluster Health & Daemons
HEARTBEAT_INTERVAL=5000
SCRUBBER_INTERVAL=3600000
HEAL_INTERVAL=10000

# Optional: Cloud Database & Remote S3 Sync (Leave blank for pure local cluster)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
